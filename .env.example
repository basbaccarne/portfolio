# Copy this file to .env.local and fill in the three values.
# Without them the app runs on this browser's local storage only.
#
# The first two are in the Supabase dashboard under Project Settings -> API.
# The anon key is meant to be public; the data is protected by the rules in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# E-mail of the single team user created under Authentication -> Users.
# Its password is the shared team password. Never put the password in this file.
VITE_TEAM_EMAIL=portfolio-team@example.org
